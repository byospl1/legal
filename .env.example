# Copiar a .env en el servidor (NUNCA subir .env real a git) y completar:

# Clave que firma la cookie de sesión del login. Generar una real con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Si cambia, todos los usuarios logueados pierden la sesión — generarla UNA
# vez y no tocarla en redeploys futuros.
SECRET_KEY=

# Dominio o subdominio que apunta a la IP de la VM (ej. eoir.tudominio.com,
# o un subdominio gratis de DuckDNS: tudespacho.duckdns.org). Caddy pide el
# certificado HTTPS automático para este nombre — ver DEPLOY.md.
DOMAIN=
