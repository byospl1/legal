venv/
__pycache__/
*.pyc
.coverage
.ruff_cache/
_qa_auditoria*/

# datos de clientes: no se suben al repositorio
case_store/*.json*
case_store/_audit.log

# credenciales de login: nunca se suben al repositorio
usuarios/*.json
input/*
output/*
!input/.gitkeep
!output/.gitkeep

# firmas escaneadas (PNG) de abogados/preparadores: se agregan localmente
# en cada despacho, no viajan con el código
firmas/abogados/*.png
firmas/preparadores/*.png

.DS_Store

# secretos de despliegue (SECRET_KEY, dominio) — nunca en git
.env

# Nota: la config de Firebase del despacho (firebase-api-key.txt /
# firebase-project-id.txt) SÍ está versionada en este repositorio PRIVADO a
# propósito, para que viaje con la descarga. La Web API key no es secreta (va
# en cualquier app cliente); la protección real es cerrar el auto-registro en
# Firebase + las reglas de Firestore (ver README) + que el repo siga privado.
